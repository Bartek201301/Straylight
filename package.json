{
  "name": "straylight",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss",
    "./src/app/globals.css"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run compress-assets",
    "build:production": "npm run optimize-images && next build && npm run compress-assets",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install",
    "optimize-images": "node scripts/optimize-images.js",
    "optimize-images:verbose": "node scripts/optimize-images.js --verbose",
    "compress-assets": "node scripts/compress-assets.js",
    "prebuild": "node scripts/optimize-images-simple.js",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "madge:circular": "madge --circular --ts-config tsconfig.json src/",
    "analyze": "cross-env ANALYZE=true next build",
    "metrics": "node scripts/collect-metrics.js"
  },
  "dependencies": {
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@supabase/ssr": "^0.1.0",
    "@supabase/supabase-js": "^2.52.0",
    "@tiptap/extension-image": "^3.0.7",
    "@tiptap/react": "^3.0.7",
    "@tiptap/starter-kit": "^3.0.7",
    "@types/ioredis": "^4.28.10",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "clsx": "^2.1.1",
    "cobe": "^0.6.4",
    "framer-motion": "^12.23.12",
    "glob": "^10.3.0",
    "ioredis": "^5.7.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.540.0",
    "next": "^14.0.0",
    "ogl": "^1.0.11",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.33.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "unified": "^11.0.5",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@tailwindcss/typography": "^0.5.16",
    "@types/mailchimp__mailchimp_marketing": "^3.0.21",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "autoprefixer": "^10.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "^14.0.0",
    "husky": "^8.0.0",
    "knip": "^5.83.1",
    "lint-staged": "^15.0.0",
    "madge": "^8.0.0",
    "postcss": "^8.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
