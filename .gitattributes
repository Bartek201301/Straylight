# Ensure consistent line endings across all platforms
* text=auto

# Force LF for specific file types that should always use LF
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.svg text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary

# Exclude generated files from line ending normalization
*.min.js binary
*.min.css binary
build/ binary
dist/ binary
node_modules/ binary
.next/ binary